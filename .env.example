# Nativity.AI - Environment Variables

# ==========================================
# 1. Google Gemini API (AI Analysis)
# ==========================================
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. Cloudflare R2 (Video Storage)
# ==========================================
# Get from: Cloudflare Dashboard -> R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=nativity-videos
# Optional: If you mapped a custom domain or use R2.dev public URL
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ==========================================
# 3. Supabase PostgreSQL (Job Storage)
# ==========================================
# Get from: Supabase Dashboard -> Project Settings -> Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ==========================================
# 4. Redis + Celery (Queue & Cache)
# ==========================================
# Get from: Upstash Dashboard -> Redis -> Connect
REDIS_URL=rediss://default:your_upstash_password@your-upstash-host:6379

# ==========================================
# 5. Clerk Auth (Frontend & Backend Validation)
# ==========================================
# Get from: Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Needed for backend token validation
CLERK_ISSUER_URL=https://your-clerk-issuer-url

# ==========================================
# 6. Application Configuration
# ==========================================
MAX_FILE_SIZE_MB=500
# For local development frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
